---
// ===========================
// src/pages/[blog]/[...slug].astro
// Phase 3 更新版: Astro i18n Starter デザイン適用
// ===========================

// ===========================
// インポート
// ===========================
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import SocialShareButtons from "@/components/SocialShareButtons.astro";  // add for SocialShare
import { getLangFromUrl } from "@/i18n/utils";

// ===========================
// 多言語対応の getStaticPaths
// ===========================
export const getStaticPaths = (async () => {
  const posts = await getCollection("blog", (entry) => !entry.data.isDraft);

  // 言語設定
  const langConfigs = {
    ja: { prefix: "ja/", blogPath: "/blog" },           // /blog/any-post/
    en: { prefix: "en/", blogPath: "/en/blog" },        // /en/blog/any-post/
  };

  const createPath = (post, lang, blogPath) => {
    return {
      params: { 
        blog: blogPath,                                      // [blog] パラメータ
        slug: post.id.split("/")[1].replace(/\.mdx?$/, '')  // [...slug] パラメータ
      },
      props: { post, lang },
    };
  };

  // 全言語の全記事パスを生成
  return Object.entries(langConfigs).flatMap(([lang, { prefix, blogPath }]) =>
    posts
      .filter((post) => post.id.startsWith(prefix))
      .map((post) => createPath(post, lang, blogPath))
  );
}) satisfies GetStaticPaths;

// ===========================
// Props
// ===========================
const { post, lang } = Astro.props;

// ===========================
// 現在の言語を取得
// ===========================
const currentLang = getLangFromUrl(Astro.url);

// ===========================
// Content と headings を取得
// ===========================
const { Content, headings } = await post.render();

// ===========================
// timeline-scope 用のタイムライン名を収集
// ===========================
const safeId = (id: string) => id.replace(/[^a-zA-Z0-9-_]/g, '-');
const filteredHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 3);
const timelineScope = filteredHeadings
  .map(h => `--heading-${safeId(h.slug)}`)
  .join(' ');

// ===========================
// SEO用メタデータ（Phase 1 の新形式に対応）
// ===========================
const title = post.data.title;
const description = post.data.description || 'ブログ記事';
const image = post.data.eyecatch?.url || post.data.image || undefined;

// meta オブジェクトを作成
const meta = {
  description: description,
  image: image,
  article: true,
  type: "article",
  robots: "index, follow",
};

// ===========================
// 記事の完全URLを生成（SNSシェア用）
// ===========================
const siteUrl = Astro.site?.toString() || 'https://example.com';
const fullUrl = new URL(Astro.url.pathname, siteUrl).toString();
---

<Layout title={title} meta={meta}>
  <!-- ===========================
       timeline-scope を共通親要素に設定
       =========================== -->
  <div class="page-wrapper" style={`timeline-scope: ${timelineScope};`}>
    <section role="main" aria-labelledby="article-title" class="article-container">
      <article class="article-content">
        <!-- 記事画像（存在すれば） -->
        {(post?.data?.eyecatch?.url || post?.data?.image) && (
          <img 
            src={post.data.eyecatch?.url || post.data.image} 
            alt={post?.data?.title}
            class="article-eyecatch"
            loading="eager"
          />
        )}

        <!-- 記事タイトル -->
        <h1 id="article-title" class="article-title">
          {post?.data?.title}
        </h1>

        <!-- 記事メタ情報 -->
        <div id="article-meta" class="article-meta">
          {post?.data?.description && (
            <p class="article-description">
              {post.data.description}
            </p>
          )}
          <time 
            datetime={post.data.pubDate.toISOString()}
            class="article-date"
          >
            {post.data.pubDate.toLocaleDateString(lang === 'ja' ? 'ja-JP' : 'en-US')}
          </time>
          
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="article-tags">
              {post.data.tags.map((tag) => (
                <span class="tag">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- ===========================
             3カラムレイアウト（ソーシャル + 本文 + ToC）
             =========================== -->
        <div class="article-layout-3col">
          <!-- 1 左サイドバー: ソーシャルシェア -->
          <div class="social-sidebar">
            <SocialShareButtons 
              title={post.data.title} 
              url={fullUrl}
              lang={lang}
            />
          </div>
              
          <!-- 2 中央: モバイル用ToC + 本文 -->
          <div class="article-main">
            <!-- モバイル用 ToC（記事上部） -->
            <div class="toc-mobile">
              <TableOfContents headings={headings} lang={lang} />
            </div>
                
            <!-- 記事本文 -->
            <main class="article-body">
              <section 
                id="md-content"
                class="prose prose-lg dark:prose-invert max-w-none
                       prose-headings:scroll-mt-20
                       prose-h2:text-2xl prose-h2:font-bold prose-h2:mt-8 prose-h2:mb-4
                       prose-h3:text-xl prose-h3:font-semibold prose-h3:mt-6 prose-h3:mb-3
                       prose-a:text-blue-600 dark:prose-a:text-blue-400
                       prose-code:text-pink-600 dark:prose-code:text-pink-400
                       prose-pre:bg-gray-900 dark:prose-pre:bg-gray-950"
              >
                <Content />
              </section>
            </main>
          </div>
              
          <!-- 3 右サイドバー: ToC -->
          <aside class="toc-desktop">
            <TableOfContents headings={headings} lang={lang} />
          </aside>
        </div>

        <!-- フッター（記事下のナビゲーション） -->
        <footer class="article-footer">
          <a 
            href={lang === 'ja' ? '/' : '/en/'} 
            class="back-link"
          >
            ← {lang === 'ja' ? '記事一覧に戻る' : 'Back to articles'}
          </a>
        </footer>
      </article>
    </section>
  </div>
</Layout>

<style>
  /* ===========================
     ページ全体のラッパー
     =========================== */
  .page-wrapper {
    width: 100%;
  }

  /* ===========================
     記事コンテナ
     =========================== */
  .article-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .article-content {
    width: 100%;
  }

  /* ===========================
     記事画像
     =========================== */
  .article-eyecatch {
    width: 100%;
    max-height: 500px;
    object-fit: cover;
    border-radius: 0.75rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  /* ===========================
     記事タイトル
     =========================== */
  .article-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--color-text-primary, #111827);
  }

  /* ===========================
     記事メタ情報
     =========================== */
  .article-meta {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
  }

  .article-description {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #6b7280);
    margin-bottom: 1rem;
  }

  .article-date {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted, #9ca3af);
    margin-bottom: 0.75rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .tag {
    display: inline-block;
    background: var(--color-bg-secondary, #f3f4f6);
    color: var(--color-text-secondary, #6b7280);
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background 0.2s;
  }

  .tag:hover {
    background: var(--color-bg-hover, #e5e7eb);
  }

  /* ===========================
     3カラムレイアウト
     =========================== */
 .article-layout-3col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  /* 左サイドバー（ソーシャルシェア） */
  .social-sidebar {
    display: none;  /* モバイルでは非表示 */
  }

  /* 中央（本文コンテナ） */
  .article-main {
    flex: 1;
    min-width: 0;
  }

  /* モバイル用 ToC */
  .toc-mobile {
    display: block;
    margin-bottom: 2rem;
  }

  /* デスクトップ用 ToC */
  .toc-desktop {
    display: none;
  }

  /* 記事本文 */
  .article-body {
    width: 100%;
  }

  /* ===========================
     デスクトップ表示（3カラム Grid）
     =========================== */
   @media (min-width: 1024px) {
    .article-layout-3col {
      display: grid;
      grid-template-columns: 4rem 1fr 18rem;  /* 左64px 中央可変 右288px */
      gap: 3rem;
      align-items: start;
    }

    /* 左サイドバー表示 */
    .social-sidebar {
      display: block;
    }

    /* モバイル ToC を非表示 */
    .toc-mobile {
      display: none;
    }

    /* デスクトップ ToC を表示 */
    .toc-desktop {
      display: block;
    }

    /* 記事本文の設定 */
    .article-body {
      min-width: 0;  /* Grid内でのオーバーフロー防止 */
      max-width: 100%;
    }

    .article-title {
      font-size: 3rem;
    }
  }

  /* ===========================
     超ワイド画面対応（オプション）
     =========================== */
   @media (min-width: 1280px) {
    .article-layout-3col {
      grid-template-columns: 5rem 1fr 20rem;  /* 左80px 中央可変 右320px */
      gap: 4rem;
    }
  }

  /* ===========================
     記事フッター
     =========================== */
  .article-footer {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, #e5e7eb);
  }

  .back-link {
    display: inline-block;
    color: var(--color-primary, #3b82f6);
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* ===========================
     ダークモード
     =========================== */
  :global(.dark) .article-title {
    color: var(--color-text-primary-dark, #f9fafb);
  }

  :global(.dark) .article-description {
    color: var(--color-text-secondary-dark, #d1d5db);
  }

  :global(.dark) .article-date {
    color: var(--color-text-muted-dark, #9ca3af);
  }

  :global(.dark) .tag {
    background: var(--color-bg-secondary-dark, #374151);
    color: var(--color-text-secondary-dark, #d1d5db);
  }

  :global(.dark) .tag:hover {
    background: var(--color-bg-hover-dark, #4b5563);
  }

  :global(.dark) .back-link {
    color: var(--color-primary-dark, #60a5fa);
  }
</style>
